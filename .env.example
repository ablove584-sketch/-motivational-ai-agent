# AI Provider Settings (سيتم تحديدها لاحقاً، مثلاً: openai, anthropic, أو local)
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here

# Database Settings
DATABASE_URL=postgresql://user:password@localhost:5432/motivational_agent

# Application Settings
TIMEZONE=Asia/Riyadh
GENERATION_INTERVAL_MINUTES=60
SIMILARITY_THRESHOLD=0.85
